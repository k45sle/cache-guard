{
  "cache-guard": {
    "SessionStart": [
      {
        "type": "command",
        "command": "sh ./hooks/cache-guard.sh",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "sh ./hooks/cache-guard.sh",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|run_command|define_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "sh ./hooks/cache-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|run_command|define_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "sh ./hooks/cache-guard.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
